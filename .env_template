# LLM provider credentials
OPENAI_API_KEY=

# Required for gated HuggingFace datasets (e.g. GPQA) used by the EvoMemory
# single-turn benchmarks; mint one at https://huggingface.co/settings/tokens
HF_TOKEN=

# Postgres with pgvector for the Letta memory plugin, e.g.
# postgresql://localhost:5432/letta; see memory_plugins/heams_memory_letta/README.md
LETTA_PG_URI=

# Results dashboard on a Slurm cluster (python_package/cluster/browse_dashboard.sh).
# Required: SSH host of the cluster's login node (from ~/.ssh/config) and the
# results directory on the cluster's shared file system.
BROWSE_CLUSTER_HOST=
BROWSE_RESULTS_DIR=
# Optional Slurm placement and job resources (defaults: cluster defaults, 2, 8G, 08:00:00).
BROWSE_SLURM_PARTITION=
BROWSE_SLURM_ACCOUNT=
BROWSE_CPUS=
BROWSE_MEM=
BROWSE_TIME_LIMIT=
# Optional port on your laptop (default: 8767).
BROWSE_LOCAL_PORT=
# Optional checkout and index cache on the cluster; $VARIABLES are expanded there
# (defaults: ${SCRATCH:-$HOME}/heams-browse and ...-cache).
BROWSE_REMOTE_CHECKOUT=
BROWSE_REMOTE_CACHE=
# Optional repository and branch cloned on first use (default: this repository's
# HTTPS URL, default branch); use an SSH URL or host alias if the cluster needs it.
BROWSE_REPO_URL=
BROWSE_BRANCH=
